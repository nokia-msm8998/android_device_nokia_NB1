// fstab

prebuilt_etc {
    name: "fstab.qcom",
    src: "fstab.qcom",
    vendor: true,
    ramdisk_available: true,
}

// Init configuration files

prebuilt_etc {
        name: "init.nb1.target.rc",
        src: "init.nb1.target.rc",
        sub_dir: "init/hw",
        vendor: true,
}
